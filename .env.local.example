# Supabase — copy to .env.local and fill in from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used for storage MIME validation / signed URLs.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini — server-only, used by lib/invoice/extract.ts to read invoices.
# NEVER expose this to the client (no NEXT_PUBLIC_ prefix, ever).

# Google OAuth — server-only, used by lib/gmail/auth.ts for Gmail ingestion.
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). NEVER prefix these NEXT_PUBLIC_ — the secret would
# ship to the browser.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Must match an Authorised redirect URI on that client, exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ------------------------------------------------------------------
# Gmail ingestion, phase 2 — watch, push and drain. All server-only.
# NEVER prefix any of these NEXT_PUBLIC_.
# ------------------------------------------------------------------

# The Pub/Sub topic Gmail publishes mailbox changes to. Full resource name.
# The Gmail service account (gmail-api-push@system.gserviceaccount.com) must
# have the Pub/Sub Publisher role on it, or users.watch fails with a 403.
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-invoices

# The `aud` claim the push subscription's OIDC token must carry, and the
# service account it must be issued to. Both are set on the Pub/Sub push
# subscription (Authentication → service account + audience). Together they are
# what stops anyone else POSTing a forged notification at /api/gmail/push.
GMAIL_PUSH_AUDIENCE=https://your-app.vercel.app/api/gmail/push
GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push@your-gcp-project.iam.gserviceaccount.com

# Belt and braces alongside the OIDC check: the push endpoint also requires
# ?token=<this> on the URL. Put it in the subscription's push endpoint URL.
# Any long random string.
GMAIL_PUSH_SECRET=a-long-random-string

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` on every scheduled
# request. It is the ONLY thing guarding /api/gmail/drain and
# /api/gmail/watch/renew, both of which run with the service-role key. If this
# is unset, those routes refuse every request rather than accepting any.
CRON_SECRET=another-long-random-string

# The Gmail label whose arrivals are watched and drained — an ID, not a name
# (`Label_1234567890`). Get it from Gmail's settings URL, or
# GET https://gmail.googleapis.com/gmail/v1/users/me/labels. Filtering at
# Gmail's end is what keeps ordinary mail from waking the push endpoint.
GMAIL_INVOICES_LABEL_ID=Label_0000000000000000000

# Applied to each message the drain has handled, so a human looking at the
# mailbox can see what has been read. Optional — leave unset to skip labelling.
GMAIL_PROCESSED_LABEL_ID=Label_1111111111111111111

# Ceiling on one attachment, in bytes. Default 15728640 (15MB). Real, not
# nominal: Gmail returns attachments base64-encoded inside JSON, so a 20MB file
# is ~27MB on the wire and both copies exist in memory at once. The floor is
# fixed at 20KB — below that it is a logo or a signature image, not an invoice.
GMAIL_MAX_ATTACHMENT_BYTES=15728640

