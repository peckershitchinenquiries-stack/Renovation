# Supabase — copy to .env.local and fill in from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, used for storage MIME validation / signed URLs.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini — server-only, used by lib/invoice/extract.ts to read invoices.
# NEVER expose this to the client (no NEXT_PUBLIC_ prefix, ever).

